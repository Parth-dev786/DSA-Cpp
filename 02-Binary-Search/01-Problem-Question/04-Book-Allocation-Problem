Algorithm

Algorithm: Book Allocation

Input:
    Array arr[] containing pages of N books
    M = number of students

Step 1:
    If M > N:
        Return -1

Step 2:
    Initialize:
        start = maximum element of arr[]
        end = sum of all elements of arr[]
        ans = -1

Step 3:
    While start <= end:

        mid = start + (end - start) / 2

        count = 1
        page = 0

        Step 4:
        For i = 0 to N-1:

            page = page + arr[i]

            If page > mid:
                count = count + 1
                page = arr[i]

        Step 5:
        If count <= M:
            ans = mid
            end = mid - 1

        Else:
            start = mid + 1

Step 6:
    Return ans


-----------------------------------------------------------------------------------------------------------------------------------

//code 

#include<iostream>
using namespace std;

int main() {

    int M, count, mid, start, end, ans = -1, n;
    int arr[100];

    cout << "Enter number of students: ";
    cin >> M;

    cout << "Enter number of books: ";
    cin >> n;

    cout << "Enter pages of books:\n";
    for(int i = 0; i < n; i++){
        cin >> arr[i];
    }

    start = arr[0];
    end = 0;

    for(int i = 0; i < n; i++){
        if(arr[i] > start)
            start = arr[i];
        end += arr[i];
    }

    while(start <= end){

        count = 1;
        int page = 0;

        mid = start + (end - start) / 2;

        for(int i = 0; i < n; i++){

            page += arr[i];

            if(page > mid){
                count++;
                page = arr[i];
            }
        }

        if(count <= M){
            ans = mid;
            end = mid - 1;
        }
        else{
            start = mid + 1;
        }
    }

    cout << "Minimum maximum pages = " << ans;

    return 0;
}

